PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Set during build AND server startup when deploying behind a subpath proxy.
APP_BASE_PATH=/
DATABASE_PATH=./data/ideas.sqlite
# Development only: verification codes appear in the login UI; synthetic AI is labeled.
AUTH_MODE=development
AI_MODE=demo
ADMIN_EMAILS=admin@example.com
# Production requires AUTH_MODE=password or smtp, AI_MODE=openai and HTTPS.
# For password mode, ADMIN_EMAILS holds reserved administrator account names.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Idea Notes <hello@example.com>
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_QUICK_MODEL=
# AI_DEEP_MODEL=
# AI_PROVIDER_NAME=
# AI_DATA_POLICY_URL=
# AI_DAILY_REQUEST_LIMIT=200

# WeChat Pay API v3 direct merchant. Keep disabled until your merchant is approved.
PAYMENT_ENABLED=false
PAYMENT_REFUNDS_ENABLED=false
# No default live prices: values below are integer RMB cents, not yuan.
# STANDARD_PRICE_FEN=
# PRO_PRICE_FEN=
STANDARD_POINTS=2000
PRO_POINTS=6000
# PAYMENT_SUPPORT_EMAIL=
# PAYMENT_REFUND_POLICY_URL=https://your-domain.example/refund-policy
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY_PATH=./secrets/apiclient_key.pem
# WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_...
# WECHAT_PUBLIC_KEY_PATH=./secrets/wechatpay_public_key.pem
# WECHAT_API_V3_KEY=
# WECHAT_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
# WECHAT_REFUND_NOTIFY_URL=https://your-domain.example/api/payments/wechat/refund-notify
WECHAT_H5_ENABLED=false
# Trust ONLY the actual reverse proxy's source CIDR when forwarding H5 payer IP.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
